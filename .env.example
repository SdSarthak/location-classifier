# Copy to .env and edit. Every value is optional — the defaults in
# location_classifier/config.py are used when a variable is unset or blank.
# The CLI reads these at startup; explicit command-line flags win.

# Where the labelled dataset lives (CSV with latitude, longitude, location).
LOC_CLF_DATA_PATH=data/locations.csv

# Where trained models are written. A sibling .json holds the metrics.
LOC_CLF_MODEL_PATH=models/location_classifier.joblib

# Directory for generated figures.
LOC_CLF_OUTPUT_DIR=outputs

# Estimator: random_forest | extra_trees | gradient_boosting |
#            logistic_regression | knn | svm
LOC_CLF_MODEL_NAME=random_forest

# Reproducibility and split settings.
LOC_CLF_RANDOM_SEED=42
LOC_CLF_TEST_SIZE=0.2
LOC_CLF_CV_FOLDS=5

# Number of learned reference points used for distance features.
LOC_CLF_N_ANCHORS=12

# Synthetic dataset generation.
LOC_CLF_SAMPLES_PER_CLASS=120
LOC_CLF_SPREAD_KM=6.0
